{
  "version": 1,
  "tools": [
    {
      "name": "get_product",
      "description": "Показывает цену, лимит и остатки товара. Ничего не меняет; неизвестный товар — PRODUCT_NOT_FOUND.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "product_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "price_coins": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "user_limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "stock": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "price_coins",
                  "user_limit",
                  "stock"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PRODUCT_NOT_FOUND",
                      "USER_NOT_FOUND",
                      "OUT_OF_STOCK",
                      "USER_LIMIT_EXCEEDED",
                      "INSUFFICIENT_COINS",
                      "ORDER_NOT_FOUND",
                      "ORDER_STATUS_ERROR"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
