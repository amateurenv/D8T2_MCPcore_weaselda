    {
      "name": "create_order",
      "description": "Создаёт заказ на товар выбранного размера и количества, списывает коины и уменьшает остаток одной транзакцией. Возможные отказы: USER_NOT_FOUND, PRODUCT_NOT_FOUND, OUT_OF_STOCK, USER_LIMIT_EXCEEDED и INSUFFICIENT_COINS.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "required": [
          "user_id",
          "product_id",
          "size"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "const": "created"
                  },
                  "total_price": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "order_id",
                  "status",
                  "total_price"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PRODUCT_NOT_FOUND",
                      "USER_NOT_FOUND",
                      "OUT_OF_STOCK",
                      "USER_LIMIT_EXCEEDED",
                      "INSUFFICIENT_COINS",
                      "ORDER_NOT_FOUND",
                      "ORDER_STATUS_ERROR"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
